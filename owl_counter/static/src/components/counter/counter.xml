<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="owl_counter.Counter" owl="1">
        <div class="o_counter_component d-flex flex-column align-items-center p-4">
            <h2 class="mb-4">Counter: <t t-esc="state.count"/></h2>
            <div class="btn-group">
                <button class="btn btn-primary me-2" t-on-click="increment">
                    Increment
                </button>
                <button class="btn btn-secondary" t-on-click="decrement">
                    Decrement
                </button>
            </div>
        </div>
    </t>
</templates>
<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="task_timer.TaskList" owl="1">
        <div class="task-list p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Tasks</h2>
                <button t-if="!state.showCreateForm" 
                        class="btn btn-primary"
                        t-on-click="toggleCreateForm">
                    Create Task
                </button>
            </div>
            
            <t t-if="state.showCreateForm">
                <TaskForm 
                    onTaskCreated="() => this.handleTaskCreated()"
                    onClose="() => this.toggleCreateForm()"/>
            </t>
            
            <div t-if="state.tasks.length === 0 and !state.showCreateForm" 
                 class="alert alert-info">
                No tasks found. Create your first task to get started!
            </div>
            
            <table t-if="state.tasks.length > 0" class="table">
                <thead>
                    <tr>
                        <th>Task</th>
                        <th>Total Time</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="state.tasks" t-as="task" t-key="task.id">
                        <tr>
                            <td>
                                <div class="fw-bold"><t t-esc="task.name"/></div>
                                <div class="text-muted"><t t-esc="task.description"/></div>
                            </td>
                            <td><t t-esc="task.total_time"/> hours</td>
                            <td>
                                <Timer taskId="task.id" onTimerUpdate="() => this.loadTasks()"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </div>
    </t>
</templates>
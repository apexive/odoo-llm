<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="task_timer.TaskTimerWidget" owl="1">
        <div class="d-flex align-items-center gap-3 p-2">
            <div class="timer-display px-3 py-2 bg-light rounded">
                <span class="fs-4" t-esc="state.elapsedTime"/>
            </div>
            <button t-if="!state.isRunning" 
                    class="btn btn-success"
                    t-on-click="startTimer">
                Start Timer
            </button>
            <button t-else=""
                    class="btn btn-danger"
                    t-on-click="stopTimer">
                Stop Timer
            </button>
        </div>
    </t>
</templates>
<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="task_timer.TaskForm" owl="1">
        <div class="task-form p-4 border rounded bg-light">
            <h3 class="mb-3">Create New Task</h3>
            
            <div t-if="state.error" class="alert alert-danger" role="alert">
                <t t-esc="state.error"/>
            </div>
            
            <div class="mb-3">
                <label for="taskName" class="form-label">Task Name</label>
                <input 
                    type="text" 
                    class="form-control" 
                    id="taskName"
                    t-att-value="state.name"
                    t-on-input="updateName"/>
            </div>
            
            <div class="mb-3">
                <label for="taskDescription" class="form-label">Description</label>
                <textarea 
                    class="form-control" 
                    id="taskDescription" 
                    rows="3"
                    t-att-value="state.description"
                    t-on-input="updateDescription"/>
            </div>
            
            <div class="d-flex justify-content-end gap-2">
                <button class="btn btn-secondary" t-on-click="props.onClose">Cancel</button>
                <button class="btn btn-primary" t-on-click="createTask">Create Task</button>
            </div>
        </div>
    </t>
</templates>
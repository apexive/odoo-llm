<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List/Tree View for Tasks -->
    <record id="view_task_timer_tree" model="ir.ui.view">
        <field name="name">task.timer.task.tree</field>
        <field name="model">task.timer.task</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="description"/>
                <field name="total_time"/>
                <field name="is_active"/>
            </tree>
        </field>
    </record>

    <!-- Form View for Tasks -->
    <record id="view_task_timer_form" model="ir.ui.view">
        <field name="name">task.timer.task.form</field>
        <field name="model">task.timer.task</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- We'll add our timer widget here -->
                    <widget name="task_timer_widget"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Task Name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="description"/>
                        <field name="total_time" widget="float_time"/>
                        <field name="is_active" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Time Entries" name="time_entries">
                            <field name="time_entries">
                                <tree>
                                    <field name="start_time"/>
                                    <field name="end_time"/>
                                    <field name="duration" widget="float_time"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="action_task_timer" model="ir.actions.act_window">
        <field name="name">Tasks</field>
        <field name="res_model">task.timer.task</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No tasks found. Let's create one!
            </p>
        </field>
    </record>
</odoo>
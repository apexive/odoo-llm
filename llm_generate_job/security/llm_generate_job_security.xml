<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Generation Job Manager Group -->
        <record id="group_llm_generation_job_manager" model="res.groups">
            <field name="name">LLM Generation Job Manager</field>
            <field name="category_id" ref="llm.module_category_llm"/>
            <field name="comment">Users can manage generation jobs and access all job records</field>
            <field name="implied_ids" eval="[(4, ref('llm.group_llm_manager'))]"/>
        </record>

        <!-- Generation Job User Group -->
        <record id="group_llm_generation_job_user" model="res.groups">
            <field name="name">LLM Generation Job User</field>
            <field name="category_id" ref="llm.module_category_llm"/>
            <field name="comment">Users can create and view their own generation jobs</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>

<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- PgVector store using the Odoo PostgreSQL database — no extra server needed -->
    <record id="llm_store_pgvector_default" model="llm.store">
        <field name="name">Odoo PgVector</field>
        <field name="service">pgvector</field>
        <field name="pgvector_index_method">hnsw</field>
        <field name="active">True</field>
    </record>

    <!-- LLM Meta Skills collection.
         embedding_model_id references nomic-embed-text registered by _setup_ollama_provider()
         which runs in llm_provider_data.xml (loaded before this file). -->
    <record id="llm_collection_meta_skills" model="llm.knowledge.collection">
        <field name="name">Odoo Technical Skills</field>
        <field name="description">Default knowledge collection for all technical skill documents loaded from installed addon skills/ directories.</field>
        <field name="store_id" ref="llm_store_pgvector_default"/>
        <field name="embedding_model_id" ref="llm_skills.nomic_embed_text_latest"/>
        <field name="active">True</field>
    </record>
</odoo>

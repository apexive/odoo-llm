<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!--
        Ensures the Ollama provider exists and nomic-embed-text is registered
        with a stable external ID. Idempotent on reinstall/upgrade.
        api_base defaults to http://host.docker.internal:11434.
        Override via: Settings > Technical > System Parameters > llm_skills.ollama_api_base
    -->
    <function model="llm.provider" name="_setup_ollama_provider"/>
</odoo>

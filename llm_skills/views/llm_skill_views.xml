<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_llm_skill_list" model="ir.ui.view">
        <field name="name">llm.skill.list</field>
        <field name="model">llm.skill</field>
        <field name="arch" type="xml">
            <list string="Skills" decoration-muted="not active">
                <field name="name" string="Name" />
                <field name="description" string="Description" />
                <field name="loader_id" optional="show" />
                <field name="content_hash" string="Hash" optional="hide" />
                <field name="active" optional="hide" />
            </list>
        </field>
    </record>

    <record id="view_llm_skill_form" model="ir.ui.view">
        <field name="name">llm.skill.form</field>
        <field name="model">llm.skill</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. odoo-configure-whatsapp" />
                        </h1>
                    </div>
                    <group>
                        <group string="Identity">
                            <field name="loader_id" readonly="1" />
                            <field name="source_path" readonly="1" />
                            <field name="active" widget="boolean_toggle" />
                        </group>
                        <group string="Sync">
                            <field name="content_hash" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" nolabel="1" widget="text"
                                   placeholder="Use when... (this is what gets embedded for search)" />
                        </page>
                        <page string="Content" name="content">
                            <field name="content" nolabel="1" widget="text"
                                   placeholder="Full SKILL.md body loaded on demand by odoo_skill_reader..." />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_llm_skill_search" model="ir.ui.view">
        <field name="name">llm.skill.search</field>
        <field name="model">llm.skill</field>
        <field name="arch" type="xml">
            <search string="Search Skills">
                <field name="name" string="Name" />
                <field name="description" string="Description" />
                <field name="loader_id" />
                <filter name="active" string="Active" domain="[('active','=',True)]" />
                <filter name="inactive" string="Archived" domain="[('active','=',False)]" />
                <group expand="0" string="Group By">
                    <filter name="group_loader" string="Loader" context="{'group_by': 'loader_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_llm_skill" model="ir.actions.act_window">
        <field name="name">Skills</field>
        <field name="res_model">llm.skill</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No skills loaded yet.</p>
            <p>Skills are loaded automatically from skills/ directories by the Skills Loader on Odoo start/upgrade.</p>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Cron Job: Keep Bot Operators Online -->
        <record id="ir_cron_keep_bot_operators_online" model="ir.cron">
            <field name="name">LLM Live Chat: Keep Bot Operators Online</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="state">code</field>
            <field name="code">model._cron_keep_bot_operators_online()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="doall" eval="False"/>
            <field name="priority">10</field>
        </record>

    </data>
</odoo>

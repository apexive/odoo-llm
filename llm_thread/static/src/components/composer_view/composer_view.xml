<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="llm_thread.Composer.button"  t-inherit="mail.Composer.actionButtons" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('o_Composer_actionButtons')]" position="inside">
            <button 
                class="btn btn-secondary o_composer_button_ask_ai" 
                title="Ask AI" 
                type="button"
                t-on-click="composerView.onClickAskAI"
            >
                <t t-call="llm_thread.Icon.Robot">
                    <t t-set="props" t-value="{ class: 'me-1', style: '' }" />
                </t>
                Ask AI
            </button>
            <button 
                class="btn btn-secondary o_composer_button_ai_config ms-1" 
                title="Configure AI" 
                type="button"
                t-on-click="composerView.onClickAIConfig"
            >
                <i class="fa fa-cog"/>
            </button>
        </xpath>
    </t>
</templates>
<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="llm.ChatDialog" owl="1">
        <Dialog 
            size="'xl'" 
            fullscreen="true"
            title="state.threadView?.thread.name || 'Chat'"
        >
            <div class="o_LLMChatDialog h-100 d-flex flex-column">
                <t t-if="state.isLoading">
                    <div class="d-flex align-items-center justify-content-center p-4">
                        <div class="text-center">
                            <i class="fa fa-circle-o-notch fa-spin fa-2x mb-2"/>
                            <div>Loading chat...</div>
                        </div>
                    </div>
                </t>
                <t t-elif="state.hasError">
                    <div class="alert alert-danger" role="alert">
                        <p><t t-esc="state.errorMessage"/></p>
                        <button class="btn btn-secondary" t-on-click="_loadThread">
                            Retry
                        </button>
                    </div>
                </t>
                <t t-elif="state.threadView">
                    <ThreadView 
                        className="'o_LLMThread h-100'"
                        threadView="state.threadView"
                    />
                </t>
            </div>
        </Dialog>
    </t>

    <t t-name="llm.ChatDialogAction" owl="1">
        <div t-if="threadId" class="h-100">
            <LLMChatDialog threadId="threadId"/>
        </div>
        <div t-else="" class="d-flex align-items-center justify-content-center h-100">
            <div class="text-center text-danger">
                <i class="fa fa-exclamation-triangle fa-2x mb-3"/>
                <div>No thread ID provided</div>
            </div>
        </div>
    </t>
</templates>